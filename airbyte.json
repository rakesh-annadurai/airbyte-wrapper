    {
      "name": "4. Sync connections",
      "item": [
        {
          "name": "Create sync connection (cron, selected streams)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"Connection is active\", () => pm.expect(j.status).to.eql(\"active\"));",
                  "pm.collectionVariables.set(\"connectionId\", j.connection_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
