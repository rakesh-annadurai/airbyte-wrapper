              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspaces",
                "{{workspaceId}}",
                "connections"
              ]
            },
            "description": "cron_expression is standard 5-field cron (converted for Airbyte). Omit it for a manual-only connection. Omit 'streams' to sync every stream."
          },
          "response": []
