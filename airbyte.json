            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_id\": \"{{provisionedSourceId}}\",\n  \"destination_id\": \"{{destinationId}}\",\n  \"name\": \"Faker to Postgres nightly\",\n  \"cron_expression\": \"0 3 * * *\",\n  \"streams\": [\n    { \"name\": \"users\", \"sync_mode\": \"full_refresh\", \"destination_sync_mode\": \"overwrite\" },\n    { \"name\": \"products\", \"sync_mode\": \"full_refresh\", \"destination_sync_mode\": \"overwrite\" }\n  ]\n}",
              "options": {
