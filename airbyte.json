      "name": "5. OAuth (optional, needs an OAuth connector)",
      "item": [
        {
          "name": "Get consent URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"consent_url returned\", () => pm.expect(pm.response.json().consent_url).to.be.a(\"string\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_definition_id\": \"{{oauthSourceDefinitionId}}\",\n  \"redirect_url\": \"{{redirectUrl}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/oauth/consent-url",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspaces",
                "{{workspaceId}}",
                "oauth",
                "consent-url"
              ]
            },
            "description": "Set oauthSourceDefinitionId (a connector that uses OAuth) and redirectUrl in the collection variables first. Open consent_url in a browser."
          },
          "response": []
        },
        {
          "name": "Complete OAuth",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"source_id returned\", () => pm.expect(pm.response.json().source_id).to.be.a(\"string\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_definition_id\": \"{{oauthSourceDefinitionId}}\",\n  \"redirect_url\": \"{{redirectUrl}}\",\n  \"query_params\": { \"code\": \"PASTE_CODE\", \"state\": \"PASTE_STATE\" },\n  \"source_name\": \"OAuth source\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/oauth/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspaces",
                "{{workspaceId}}",
                "oauth",
                "complete"
              ]
            },
            "description": "Paste the code and state from the callback URL after consent."
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Error handling",
      "item": [
        {
          "name": "No token (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
