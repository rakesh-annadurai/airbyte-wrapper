                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const defs = pm.response.json().source_definitions;",
                  "pm.test(\"List is not empty\", () => pm.expect(defs.length).to.be.above(0));",
                  "const faker = defs.find(d => d.name === \"Sample Data (Faker)\");",
                  "pm.test(\"Faker connector is available\", () => pm.expect(faker).to.exist);",
                  "if (faker) pm.collectionVariables.set(\"fakerDefinitionId\", faker.source_definition_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
