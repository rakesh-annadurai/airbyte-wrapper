    {
      "name": "1. Provisioning",
      "item": [
        {
          "name": "Provision client (workspace + destination only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('Has workspace_id and destination_id', () => { pm.expect(j.workspace_id).to.be.a('string'); pm.expect(j.destination_id).to.be.a('string'); });",
                  "pm.test('Workspace is named cq_<client>_workspace', () => pm.expect(j.workspace_name).to.match(/^cq_.+_workspace$/));",
                  "pm.collectionVariables.set('workspaceId', j.workspace_id);",
                  "pm.collectionVariables.set('destinationId', j.destination_id);",
                  "const sanitized = {...j}; delete sanitized.connection_checks_performed; delete sanitized.connection_checked; console.log('Sanitized provisioning response:', JSON.stringify(sanitized));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"db_host\": \"{{dbHost}}\",\n  \"db_port\": {{dbPort}},\n  \"db_name\": \"{{dbName}}\",\n  \"db_user\": \"{{dbUser}}\",\n  \"db_password\": \"{{dbPassword}}\",\n  \"db_ssl_mode\": \"{{dbSslMode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/clients/{{clientId}}/provision",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clients",
                "{{clientId}}",
                "provision"
              ]
            },
            "description": "Creates only the workspace and PostgreSQL destination. Sources are created separately using the requests in the Sources folder."
          },
          "response": []
        },
        {
          "name": "Provision same client again (expect 409; no sources in request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Error code is ALREADY_EXISTS\", () => pm.expect(pm.response.json().error).to.eql(\"ALREADY_EXISTS\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"db_host\": \"{{dbHost}}\",\n  \"db_port\": {{dbPort}},\n  \"db_name\": \"{{dbName}}\",\n  \"db_user\": \"{{dbUser}}\",\n  \"db_password\": \"{{dbPassword}}\",\n  \"db_ssl_mode\": \"{{dbSslMode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/clients/{{clientId}}/provision",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clients",
                "{{clientId}}",
                "provision"
              ]
            }
          },
          "response": []
